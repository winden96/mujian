# Copy this file to deploy/runtime/mujian.env on the server, set mode 0600,
# and pass it with: docker compose --env-file deploy/runtime/mujian.env ...
# Never commit the runtime copy.

# Public repository and immutable revision containing the exact deployed source.
AGPL_SOURCE_URL=https://github.com/winden96/mujian/tree/REPLACE_WITH_COMMIT_SHA

# Use the complete commit SHA in production, never latest or a moving branch.
MUJIAN_IMAGE_TAG=REPLACE_WITH_FULL_COMMIT_SHA
MUJIAN_APP_VERSION=v0.12.14-obs.1
MUJIAN_PRODUCTION=true
# Stable, unique per deployment/cluster. Migration snapshots are bound to it.
MUJIAN_DEPLOYMENT_ID=mujian-production
MUJIAN_DEMO_RECHARGE_ENABLED=false
MUJIAN_BRAND_NAME=幕间 AI
# 灰度验证通过后改为 claude-sonnet-4-6。
MUJIAN_DEFAULT_CHAT_MODEL=claude-opus-5
FRONTEND_BASE_URL=https://www.mujianai.com

POSTGRES_USER=mujian
# Generate URL-safe values, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-character-lowercase-hex-value
POSTGRES_DB=mujian
# Application-only database target. Production must match POSTGRES_DB; rehearsal
# commands override only this value with mujian_rehearsal.
MUJIAN_DATABASE_NAME=mujian
SESSION_SECRET=replace-with-64-character-lowercase-hex-value
CRYPTO_SECRET=replace-with-64-character-lowercase-hex-value

# Huawei Cloud OBS. Production uses temporary credentials from an ECS agency;
# do not add OBS_ACCESS_KEY_ID, OBS_SECRET_ACCESS_KEY, or a security token.
MUJIAN_IMAGE_STORAGE=obs
OBS_AUTH_MODE=ecs
OBS_REGION=cn-north-4
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET=mujianai
OBS_PREFIX=mujian/prod/public
OBS_PUBLIC_BASE_URL=https://static.mujianai.com

# Optional aliases actually exposed by configured NewAPI channels.
# MUJIAN_CHAT_MODELS=deepseek-v4-flash,gpt-5.6-sol,claude-fable-5-nc,grok-4.5
# MUJIAN_IMAGE_MODELS=nano-banana,nano-banana-pro,nano-banana-2,gpt-image-2
