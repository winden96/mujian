# Public repository containing the exact source deployed by Dockerfile.mujian.
AGPL_SOURCE_URL=https://github.com/winden96/mujian-newapi

# Use a commit SHA in production, never latest.
MUJIAN_IMAGE_TAG=6ff8c7a-local
MUJIAN_PRODUCTION=false
MUJIAN_DEMO_RECHARGE_ENABLED=true
MUJIAN_BRAND_NAME=幕间 AI
FRONTEND_BASE_URL=http://localhost:3000

POSTGRES_USER=mujian
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=mujian
SESSION_SECRET=replace-with-at-least-32-random-characters
CRYPTO_SECRET=replace-with-at-least-32-random-characters

# Optional aliases actually exposed by configured NewAPI channels.
# MUJIAN_CHAT_MODELS=deepseek-v4-flash,gpt-5.6-sol,claude-fable-5-nc,grok-4.5
# MUJIAN_IMAGE_MODELS=nano-banana,nano-banana-pro,nano-banana-2,gpt-image-2
